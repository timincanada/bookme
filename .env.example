# Postgres (Neon). Leave empty to use embedded PGLite for local demo.
DATABASE_URL=

# Auth
VITE_AUTH_ENABLED=true
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=https://your-domain
BOOKME_APP_URL=https://your-domain

# Stripe (optional until you take cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional until you send mail)
RESEND_API_KEY=
MAIL_FROM=BookMe <noreply@bookme.training>

# Live assistant (optional; local parser works without this)
XAI_API_KEY=
ASSISTANT_PROVIDER=grok

# Places autocomplete (optional)
GOOGLE_MAPS_API_KEY=

# Cron for lesson reminders
CRON_SECRET=
